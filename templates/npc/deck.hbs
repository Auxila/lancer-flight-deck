<div class="lfd-npc-frame">
  <header class="lfd-npc-head" data-tooltip="LFD.Move.Hint">
    <span class="lfd-npc-grip" aria-hidden="true"><i class="fa-solid fa-grip-vertical"></i></span>
    <span class="lfd-npc-badge" aria-hidden="true"><i class="cci cci-npc-class"></i></span>
    <div class="lfd-npc-titles">
      <span class="lfd-npc-kicker">{{#if header.round}}{{localize "LFD.Npc.Round" n=header.round}}{{else}}{{localize "LFD.Npc.Scene"}}{{/if}}</span>
      <span class="lfd-npc-title">{{localize "LFD.Npc.Title"}}</span>
    </div>
    <div class="lfd-npc-count" aria-label="{{header.aria}}">
      <b>{{header.big}}<small>/{{header.of}}</small></b>
      <span>{{header.caption}}</span>
    </div>
    <span class="lfd-npc-ctl is-help" tabindex="0" role="note" aria-label="{{localize 'LFD.Npc.HelpTitle'}}"
          data-tooltip-html="{{help}}" data-tooltip-class="{{tipClass}}"><i class="fa-solid fa-question"></i></span>
    {{#if floating}}
    <button type="button" class="lfd-npc-ctl" data-action="dock" data-tooltip="LFD.Move.Dock" aria-label="{{localize 'LFD.Move.Dock'}}">
      <i class="fa-solid fa-thumbtack"></i>
    </button>
    {{/if}}
    <button type="button" class="lfd-npc-ctl" data-action="collapse"
            data-tooltip="{{#if collapsed}}LFD.Npc.Expand{{else}}LFD.Npc.Collapse{{/if}}"
            aria-label="{{#if collapsed}}{{localize 'LFD.Npc.Expand'}}{{else}}{{localize 'LFD.Npc.Collapse'}}{{/if}}">
      <i class="fa-solid {{#if collapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
    </button>
  </header>

  {{#unless collapsed}}
  {{#if roundEnd}}
  <div class="lfd-npc-roundend" role="status">
    <span class="lfd-npc-roundend-text"><b>{{roundEnd.done}}</b><small>{{localize "LFD.Npc.RoundEnd.Hint"}}</small></span>
    <button type="button" data-action="nextRound" data-tooltip="{{roundEnd.tip}}"><i class="fa-solid fa-forward" aria-hidden="true"></i>{{localize "LFD.Npc.RoundEnd.Next"}}</button>
  </div>
  {{/if}}
  {{#if initiative}}
  <section class="lfd-init" aria-label="{{localize 'LFD.Npc.Init.Title'}}">
    <div class="lfd-init-head">
      <span class="lfd-init-title">{{localize "LFD.Npc.Init.Title"}}</span>
      <span class="lfd-init-sum">
        <span class="is-scope">{{localize "LFD.Npc.Init.AllSides"}}</span>
        {{#if initiative.acting}}<b><i class="fa-solid fa-play" aria-hidden="true"></i>{{initiative.acting}}</b>{{/if}}
        <em class="is-ready">{{localize "LFD.Npc.Init.Ready" n=initiative.ready}}</em>
        <em class="is-done">{{localize "LFD.Npc.Init.Done" n=initiative.done}}</em>
      </span>
    </div>
    <ol class="lfd-init-strip {{#if initiative.crowded}}is-crowded{{/if}}">
      {{#each initiative.entries}}
      {{#if divider}}<li class="lfd-init-divider" aria-hidden="true"><span>{{localize "LFD.Npc.Init.DoneLabel"}}</span></li>{{/if}}
      <li class="lfd-init-unit side-{{side}} is-{{state}} {{#if hidden}}is-hidden{{/if}}" data-combatant="{{id}}" data-init-token="{{tokenId}}">
        <button type="button" class="lfd-init-portrait" data-action="initSelect"
                data-tooltip-html="{{tip}}" data-tooltip-class="{{@root.tipClass}}"
                aria-label="{{name}}{{#if dup}} {{dup}}{{/if}}: {{localize (concat 'LFD.Npc.Init.State.' state)}}">
          {{#if generic}}
          <span class="lfd-init-glyph" aria-hidden="true"><i class="cci {{#if isPlayer}}cci-frame{{else}}cci-npc-class{{/if}}"></i></span>
          {{else}}
          <img src="{{img}}" alt="" draggable="false">
          {{/if}}
          {{#if (eq state "done")}}<i class="lfd-init-badge fa-solid fa-check" aria-hidden="true"></i>{{/if}}
          {{#if (eq state "defeated")}}<i class="lfd-init-badge fa-solid fa-skull" aria-hidden="true"></i>{{/if}}
          {{#if (eq state "acting")}}<i class="lfd-init-badge fa-solid fa-play" aria-hidden="true"></i>{{/if}}
          {{#if dup}}<span class="lfd-init-dup" aria-hidden="true">{{dup}}</span>{{/if}}
        </button>
        {{#if pips}}<span class="lfd-init-pips" aria-hidden="true">{{#each pips}}<i class="{{#if on}}is-on{{/if}}"></i>{{/each}}</span>{{/if}}
        <span class="lfd-init-name">{{label}}</span>
      </li>
      {{/each}}
    </ol>
  </section>
  {{/if}}
  {{#if batch}}
  <section class="lfd-npc-batch" aria-label="{{localize 'LFD.Npc.Batch.Title' n=batch.count}}">
    <div class="lfd-npc-batch-head">
      <span class="lfd-npc-batch-title" data-tooltip="{{batch.names}}"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> {{localize "LFD.Npc.Batch.Title" n=batch.count}}</span>
      <button type="button" class="lfd-npc-batch-release" data-action="batchRelease" data-tooltip="LFD.Npc.Batch.Release" aria-label="{{localize 'LFD.Npc.Batch.Release'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{#if batch.add}}
    <button type="button" class="lfd-npc-batch-add" data-action="batchAddToCombat" data-tooltip="{{batch.add.tip}}"><i class="fa-solid fa-plus" aria-hidden="true"></i>{{batch.add.label}}</button>
    {{/if}}
    <div class="lfd-npc-adjust">
      <span class="lfd-npc-adjust-label">HP</span>
      <button type="button" data-action="batchAdjust" data-resource="hp" data-delta="-5">−5</button>
      <button type="button" data-action="batchAdjust" data-resource="hp" data-delta="-1">−1</button>
      <button type="button" data-action="batchAdjust" data-resource="hp" data-delta="1">+1</button>
      <button type="button" data-action="batchAdjust" data-resource="hp" data-delta="5">+5</button>
      {{#if batch.heat}}
      <span class="lfd-npc-adjust-label">{{localize "LFD.Npc.Heat"}}</span>
      <button type="button" data-action="batchAdjust" data-resource="heat" data-delta="-1">−1</button>
      <button type="button" data-action="batchAdjust" data-resource="heat" data-delta="1">+1</button>
      <button type="button" data-action="batchAdjust" data-resource="heat" data-delta="2">+2</button>
      {{/if}}
    </div>
    <div class="lfd-npc-conds" aria-label="{{localize 'LFD.Npc.Conditions'}}" data-tooltip-class="{{tipClass}}">
      {{#each batch.quick}}
      <button type="button" class="lfd-npc-ctile k-{{kind}} {{#if (eq state 'all')}}is-on{{/if}} {{#if (eq state 'some')}}is-some{{/if}}" data-action="batchCondition" data-cond="{{id}}"
              data-tooltip-html="{{tip}}" aria-label="{{label}}" aria-pressed="{{#if (eq state 'all')}}true{{else if (eq state 'some')}}mixed{{else}}false{{/if}}">
        <img src="{{img}}" alt=""><span>{{short}}</span>
      </button>
      {{/each}}
    </div>
  </section>
  {{/if}}
  {{#if empty}}
  <p class="lfd-npc-empty">{{localize "LFD.Npc.Empty"}}</p>
  {{else}}
  <ol class="lfd-npc-list">
    {{#each rows}}
    {{#if section}}
    <li class="lfd-npc-section is-{{section.id}}">
      {{#if section.foldable}}
      <button type="button" data-action="toggleFallen" aria-expanded="{{#if section.open}}true{{else}}false{{/if}}">
        <span>{{section.label}}</span><i class="fa-solid {{#if section.open}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
      </button>
      {{else}}
      <span>{{section.label}}</span>
      {{/if}}
    </li>
    {{else}}
    <li class="lfd-npc-row disp-{{disposition}} {{#if isTurn}}is-turn{{/if}} {{#if destroyed}}is-destroyed{{/if}} {{#if expanded}}is-open{{/if}} {{#if controlled}}is-selected{{/if}} {{#if acted}}is-acted{{/if}} {{hit}}"
        data-token="{{id}}">
      <div class="lfd-npc-top" data-action="toggleRow">
        {{#if controlled}}<i class="lfd-npc-sel fa-solid fa-crosshairs" aria-hidden="true" data-tooltip="LFD.Npc.Selected"></i>{{/if}}
        <button type="button" class="lfd-npc-name" data-action="select" data-tooltip="LFD.Npc.SelectHint">{{name}}{{#if dup}}<span class="lfd-npc-dup">{{dup}}</span>{{/if}}</button>
        <span class="lfd-npc-tier">T{{tier}}</span>
        {{#each templates}}<span class="lfd-npc-tpl">{{this}}</span>{{/each}}
        {{#if outside}}<span class="lfd-npc-tpl is-outside" data-tooltip="LFD.Npc.OutsideHint">{{localize "LFD.Npc.Outside"}}</span>{{/if}}
        <span class="lfd-npc-spacer"></span>
        {{#if targetedBy.length}}
        <span class="lfd-npc-targeted" data-tooltip="{{localize 'LFD.Npc.TargetedBy' names=targetedNames}}">
          <i class="fa-solid fa-crosshairs" aria-hidden="true"></i>{{#each targetedBy}}<b style="--c: {{color}}"></b>{{/each}}
        </span>
        {{/if}}
        {{#if activations}}
        <span class="lfd-npc-acts" data-tooltip="LFD.Npc.Activations">{{#each activations}}<i class="{{#if on}}is-on{{/if}}"></i>{{/each}}</span>
        {{/if}}
        {{#if inCombat}}
        {{#if isTurn}}
        <button type="button" class="lfd-npc-go is-end" data-action="endTurn" data-combatant="{{combatantId}}" data-tooltip="LFD.Npc.EndTurnHint"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>{{localize "LFD.Npc.EndTurn"}}</button>
        {{else if canAct}}
        <button type="button" class="lfd-npc-go" data-action="activate" data-combatant="{{combatantId}}" data-tooltip="LFD.Npc.ActivateHint" aria-label="{{localize 'LFD.Npc.Activate'}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button>
        {{/if}}
        {{/if}}
        <i class="fa-solid fa-chevron-down lfd-npc-chev" aria-hidden="true"></i>
      </div>

      <div class="lfd-npc-bars" data-action="toggleRow">
        <div class="lfd-npc-bar is-hp lvl-{{hp.level}}" aria-label="HP {{hp.value}}/{{hp.max}}">
          <span style="width: {{hp.pct}}%"></span><b>{{hp.value}}<small>/{{hp.max}}</small></b>
        </div>
        {{#if heat.value}}
        <div class="lfd-npc-bar is-heat {{#if heat.danger}}is-danger{{/if}}" aria-label="Heat {{heat.value}}/{{heat.max}}" data-tooltip="LFD.Npc.Heat">
          <span style="width: {{heat.pct}}%"></span><b>{{heat.value}}<small>/{{heat.max}}</small></b>
        </div>
        {{/if}}
        {{#if structure}}<span class="lfd-npc-pips is-structure" data-tooltip="LFD.Npc.Structure">{{#each structure}}<i class="{{#if on}}is-on{{/if}}"></i>{{/each}}</span>{{/if}}
        {{#if stress}}<span class="lfd-npc-pips is-stress" data-tooltip="LFD.Npc.Stress">{{#each stress}}<i class="{{#if on}}is-on{{/if}}"></i>{{/each}}</span>{{/if}}
      </div>

      {{#if hasChips}}
      <div class="lfd-npc-chips" data-action="toggleRow" data-tooltip-class="{{@root.tipClass}}">
        {{#each conditions}}<span class="lfd-npc-cond k-{{kind}} {{#if lockon}}is-lockon{{/if}}" {{#if tip}}data-tooltip-html="{{tip}}"{{else}}data-tooltip="{{label}}"{{/if}}>{{#if img}}<img src="{{img}}" alt="">{{/if}}{{short}}</span>{{/each}}
        {{#if burn}}<span class="lfd-npc-chip is-burn" data-tooltip="LFD.Npc.Burn">{{localize "LFD.Npc.BurnShort" n=burn}}</span>{{/if}}
        {{#if overshield}}<span class="lfd-npc-chip is-os" data-tooltip="LFD.Npc.Overshield">{{localize "LFD.Npc.OverShort" n=overshield}}</span>{{/if}}
      </div>
      {{/if}}

      {{#if expanded}}
      <div class="lfd-npc-detail">
        {{#each features}}
        <section class="lfd-npc-feature-group is-{{type}}">
          <h5><i class="{{icon}}" aria-hidden="true"></i>{{label}}</h5>
          <div class="lfd-npc-features">
            {{#each items}}
            <button type="button" class="lfd-npc-feature is-{{state}} {{#if passive}}is-passive{{/if}} {{#if line}}has-line{{/if}}" data-action="feature" data-feature="{{id}}">
              <i class="{{icon}}" aria-hidden="true"></i><span>{{name}}</span>
              {{#if line}}<small class="lfd-npc-line">{{line}}</small>{{/if}}
              {{#if recharge}}<em class="is-recharge">{{recharge}}</em>{{/if}}
              {{#if uses}}<em>{{uses}}</em>{{/if}}
            </button>
            {{/each}}
          </div>
        </section>
        {{/each}}

        <p class="lfd-npc-statline">{{#each stats}}<span><b>{{label}}</b>{{value}}</span>{{/each}}</p>

        <div class="lfd-checks" role="group" aria-label="{{localize 'LFD.Check.Group'}}" data-tooltip-class="{{@root.tipClass}}">
          {{#each checks}}
          <button type="button" class="lfd-check lfd-check-{{id}}" data-action="rollCheck" data-check="{{id}}"
                  data-tooltip-html="{{localize 'LFD.Check.Tip' name=(localize (concat 'LFD.Check.' key '.Name')) formula=formula use=(localize (concat 'LFD.Check.' key '.Use'))}}"
                  aria-label="{{localize 'LFD.Check.Aria' name=(localize (concat 'LFD.Check.' key '.Name')) formula=formula}}">
            <span class="lfd-check-name">{{localize (concat 'LFD.Check.' key '.Short')}}</span>
            <span class="lfd-check-bonus">{{bonus}}</span>
          </button>
          {{/each}}
        </div>

        <div class="lfd-npc-adjust">
          <span class="lfd-npc-adjust-label">HP</span>
          <button type="button" data-action="adjust" data-resource="hp" data-delta="-5">−5</button>
          <button type="button" data-action="adjust" data-resource="hp" data-delta="-1">−1</button>
          <button type="button" data-action="adjust" data-resource="hp" data-delta="1">+1</button>
          <button type="button" data-action="adjust" data-resource="hp" data-delta="5">+5</button>
          {{#if heat}}
          <span class="lfd-npc-adjust-label">{{localize "LFD.Npc.Heat"}} <b class="{{#if heat.danger}}is-danger{{/if}}">{{heat.value}}/{{heat.max}}</b></span>
          <button type="button" data-action="adjust" data-resource="heat" data-delta="-1">−1</button>
          <button type="button" data-action="adjust" data-resource="heat" data-delta="1">+1</button>
          <button type="button" data-action="adjust" data-resource="heat" data-delta="2">+2</button>
          {{/if}}
        </div>

        <div class="lfd-npc-conds" aria-label="{{localize 'LFD.Npc.Conditions'}}" data-tooltip-class="{{@root.tipClass}}">
          {{#each quick}}
          <button type="button" class="lfd-npc-ctile k-{{kind}} {{#if on}}is-on{{/if}}" data-action="condition" data-cond="{{id}}" {{#if tip}}data-tooltip-html="{{tip}}"{{else}}data-tooltip="{{label}}"{{/if}} aria-label="{{label}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">
            <img src="{{img}}" alt=""><span>{{short}}</span>
          </button>
          {{/each}}
        </div>

        <div class="lfd-npc-cmds">
          {{#if anyUncharged}}
          <button type="button" data-action="recharge"><i class="fa-solid fa-dice-d6"></i>{{localize "LFD.Npc.Recharge"}}</button>
          {{/if}}
          <button type="button" data-action="sheet"><i class="fa-solid fa-id-card"></i>{{localize "LFD.Npc.Sheet"}}</button>
          {{#if turn.add}}
          <div class="lfd-npc-turn-cmds is-add">
            <button type="button" class="lfd-npc-turn-btn is-add is-live" data-action="addToCombat" data-tooltip="{{turn.add.tip}}">
              <i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{localize "LFD.Npc.Turn.Add"}}</span>
            </button>
          </div>
          {{else if turn}}
          <div class="lfd-npc-turn-cmds">
            <button type="button" class="lfd-npc-turn-btn is-activate {{#if turn.activate.on}}is-live{{/if}}" data-action="activate" data-combatant="{{turn.combatantId}}"
                    aria-disabled="{{#if turn.activate.on}}false{{else}}true{{/if}}" data-tooltip="{{turn.activate.tip}}">
              <i class="fa-solid fa-play" aria-hidden="true"></i><span>{{localize "LFD.Npc.Turn.Activate"}}</span>
            </button>
            <button type="button" class="lfd-npc-turn-btn is-end {{#if turn.end.on}}is-live{{/if}}" data-action="endTurn" data-combatant="{{turn.combatantId}}"
                    aria-disabled="{{#if turn.end.on}}false{{else}}true{{/if}}" data-tooltip="{{turn.end.tip}}">
              <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i><span>{{localize "LFD.Npc.Turn.End"}}</span>
            </button>
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}
    </li>
    {{/if}}
    {{/each}}
  </ol>
  {{/if}}
  {{#if controls}}
  <footer class="lfd-npc-ctrlbar" aria-label="{{localize 'LFD.Npc.Ctrl.Label'}}">
    <button type="button" class="is-prev" data-action="prevRound" aria-disabled="{{#if controls.prev.on}}false{{else}}true{{/if}}" data-tooltip="{{controls.prev.tip}}">
      <i class="fa-solid fa-backward-step" aria-hidden="true"></i><span>{{localize "LFD.Npc.Ctrl.Prev"}}</span>
    </button>
    <button type="button" class="is-undo" data-action="undoTurn" aria-disabled="{{#if controls.undo.on}}false{{else}}true{{/if}}" data-tooltip="{{controls.undo.tip}}">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>{{localize "LFD.Npc.Ctrl.Undo"}}</span>
    </button>
    <button type="button" class="is-next" data-action="nextRound" data-tooltip="{{controls.next.tip}}">
      <span>{{localize "LFD.Npc.Ctrl.Next"}}</span><i class="fa-solid fa-forward-step" aria-hidden="true"></i>
    </button>
    <button type="button" class="is-end" data-action="endEncounter" data-tooltip="{{controls.end.tip}}">
      <i class="fa-solid fa-stop" aria-hidden="true"></i><span>{{localize "LFD.Npc.Ctrl.End"}}</span>
    </button>
  </footer>
  {{/if}}
  {{/unless}}
</div>
