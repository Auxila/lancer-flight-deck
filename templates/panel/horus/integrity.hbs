{{!-- HORUS integrity: a process listing. Each track is a line watched by its own glyphs (structure: eyes
      that close when a box is lost; stress: sigil rings that break), with the next check under it as a
      tree branch: the roll, the odds bar, what's at stake. --}}
<section class="lfd-integrity lfd-plate lfd-body lfd-horus-watch" aria-label="{{localize 'LFD.Integrity.Title'}}">
  {{#unless standby}}
  <div class="lfd-section-title">
    <span>{{localize "LFD.Integrity.Title"}}</span>
    {{#if integrity.altRules}}<span class="lfd-odds-alt" data-tooltip="LFD.Integrity.AltRulesTip">{{localize "LFD.Integrity.AltRules"}}</span>{{/if}}
  </div>
  {{#each integrity.tracks}}
  <div class="lfd-track lfd-state-{{state}}" data-track="{{kind}}">
    <div class="lfd-track-head">
      <span class="lfd-track-label">{{localize label}}</span>
      <span class="lfd-pips lfd-horus-{{kind}}" role="img" aria-label="{{localize label}} {{value}}/{{max}}">
        {{#each pips}}<span class="lfd-pip {{#if intact}}is-intact{{else}}is-lost{{/if}}" style="--i:{{@index}}"></span>{{/each}}
      </span>
      <span class="lfd-readout">{{value}}<small>/{{max}}</small></span>
    </div>
    {{#if segments}}
    <div class="lfd-odds lfd-horus-branch" data-tooltip-html="{{tooltip}}" data-tooltip-class="{{@root.tipClass}}" {{#if @root.tipDirection}}data-tooltip-direction="{{@root.tipDirection}}"{{/if}}>
      <span class="lfd-horus-roll">{{dice}}</span>
      <div class="lfd-odds-bar">
        {{#each segments}}<span class="lfd-band lfd-band-{{kind}} {{#if check}}is-check{{/if}}" style="flex-basis:{{width}}%"></span>{{/each}}
      </div>
      <span class="lfd-odds-loss {{#if lossOnCheck}}is-check{{/if}}">{{loss}}</span>
    </div>
    {{else if headline}}
    <div class="lfd-odds lfd-odds-final lfd-horus-branch" {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="{{@root.tipClass}}" {{#if @root.tipDirection}}data-tooltip-direction="{{@root.tipDirection}}"{{/if}}{{/if}}>
      <span class="lfd-k-warning">{{headline}}</span>
    </div>
    {{/if}}
  </div>
  {{/each}}
  {{/unless}}
</section>
